# Example only. Do not commit a populated copy.
# Example image reviewed on 2026-09-03. This file does not pull or deploy it;
# re-review the exact release before production and never replace it with :latest.
N8N_IMAGE=n8nio/n8n:1.123.76

# Public HTTPS endpoint
N8N_HOST=n8n.example.sa
N8N_PROTOCOL=https
N8N_PORT=5678
# n8n v1 uses WEBHOOK_URL. Re-check this name when upgrading to v2.
WEBHOOK_URL=https://n8n.example.sa/
N8N_EDITOR_BASE_URL=https://n8n.example.sa/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true

# Main n8n application database only. Never put the webhook HMAC secret or
# receipt ledger in this database. The service must use the limited schema owner below,
# never the Render-managed wathaiqi_n8n break-glass administrator. Bootstrap
# verifies this role is LOGIN/INHERIT but NOSUPERUSER, NOCREATEDB, NOCREATEROLE,
# NOREPLICATION, and NOBYPASSRLS before the service may resume.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=wathaiqi_n8n_app
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_CONNECTION_TIMEOUT=60000

# Generate once, store in the platform secret manager, and back up securely.
# Losing or changing this value makes stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=

# Minimize retained webhook/execution data. Validate these names against the
# pinned n8n release before deployment.
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=24
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000

# Receiver requests are under 4 KiB; this is a service-level upper bound in MB.
N8N_PAYLOAD_SIZE_MAX=1
N8N_LOG_LEVEL=warn
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_COMMUNITY_PACKAGES_ENABLED=false
N8N_PUBLIC_API_DISABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
# The constrained Render free pilot cannot keep the v2 internal task runners
# inside its memory limit. This pinned v1 receiver executes its two reviewed
# Code nodes in-process. Production must move to a sized v2 deployment with
# external task runners before this compatibility release is retired.
N8N_RUNNERS_ENABLED=false
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Reduce host-level capabilities. The receiver needs Webhook, Code, IF,
# PostgreSQL, Respond to Webhook, and Sticky Note only.
NODES_EXCLUDE=["n8n-nodes-base.executeCommand","n8n-nodes-base.readWriteFile","n8n-nodes-base.crypto"]

# The HMAC secret is deliberately absent from n8n. Store its decoded bytes in
# the private table of the separate wathaiqi_n8n_receipts database through the
# documented parameterized operator statement. The workflow's PostgreSQL
# credential must use wathaiqi_n8n_receiver_login and that receiver DB only.
