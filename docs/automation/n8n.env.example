# Example only. Do not commit a populated copy.
# Pin an approved n8n 2.x container image instead of using :latest.

# Public HTTPS endpoint
N8N_HOST=n8n.example.sa
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n.example.sa/
N8N_PROXY_HOPS=1
N8N_SECURE_COOKIE=true

# Dedicated n8n PostgreSQL database. Never use the application DB/user here.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=
DB_POSTGRESDB_PASSWORD=
DB_POSTGRESDB_SCHEMA=n8n
DB_POSTGRESDB_SSL_ENABLED=true

# Generate once, store in the platform secret manager, and back up securely.
# Losing or changing this value makes stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=

# Minimize retained webhook/execution data. Validate these names against the
# pinned n8n release before deployment.
EXECUTIONS_DATA_SAVE_ON_ERROR=none
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=24
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000

# Receiver requests are under 4 KiB; this is a service-level upper bound in MB.
N8N_PAYLOAD_SIZE_MAX=1
N8N_LOG_LEVEL=warn
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_TEMPLATES_ENABLED=false
N8N_PUBLIC_API_DISABLED=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_BLOCK_FILE_ACCESS_TO_N8N_FILES=true
N8N_RUNNERS_ENABLED=true

# Reduce host-level capabilities. The receiver needs Webhook, Code, IF,
# Crypto, PostgreSQL, Respond to Webhook, and Sticky Note only.
NODES_EXCLUDE=["n8n-nodes-base.executeCommand","n8n-nodes-base.readWriteFile"]

# The HMAC secret is deliberately absent. Store the printable receiver secret
# in an encrypted n8n Crypto credential, not in this file or workflow JSON.
