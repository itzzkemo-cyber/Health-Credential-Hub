{
  "expo": {
    "name": "Health Credential Hub",
    "slug": "health-credential-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthcredentialhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itzzkemo.healthcredentialhub",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.itzzkemo.healthcredentialhub"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج التطبيق للوصول إلى صورك لرفع الوثائق.",
          "cameraPermission": "يحتاج التطبيق للوصول إلى الكاميرا لالتقاط صور الوثائق."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
