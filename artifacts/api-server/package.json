{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs",
    "bootstrap:admin": "node --env-file-if-exists=../../.env --import tsx src/bootstrap-admin.ts",
    "automation:run": "node --env-file-if-exists=../../.env --import tsx src/automation-worker.ts",
    "seed:demo": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^1.44.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "otpauth": "^9.5.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "esbuild": "0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
