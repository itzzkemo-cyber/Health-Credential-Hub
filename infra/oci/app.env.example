# Future OCI production runtime contract. There is no active OCI release script.
NODE_ENV=production
PORT=8080
BIND_HOST=0.0.0.0
PUBLIC_APP_URL=https://app.wathaiqihealth.com
APP_ORIGINS=https://app.wathaiqihealth.com
SESSION_COOKIE_SAME_SITE=lax
OBJECT_STORAGE_PROVIDER=oci
PRIVATE_OBJECT_DIR=/BUCKET_NAME/private
OCI_OBJECT_STORAGE_REGION=me-riyadh-1
OCI_OBJECT_STORAGE_ENDPOINT=https://NAMESPACE.compat.objectstorage.me-riyadh-1.oraclecloud.com
EMAIL_ALERTS_DISABLED=1
AUTOMATION_OUTBOX_ENABLED=false
AUTOMATION_WEBHOOK_ENABLED=false

# Store these five values as one base64-encoded JSON secret in OCI Vault.
# Keep every value empty in this committed example.
DATABASE_URL=
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
OCI_OBJECT_STORAGE_ACCESS_KEY_ID=
OCI_OBJECT_STORAGE_SECRET_ACCESS_KEY=
