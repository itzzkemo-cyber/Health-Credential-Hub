# Runtime
NODE_ENV=development
PORT=3000
BIND_HOST=127.0.0.1
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=
# Production uses a login with only the DML role below. The migration job uses
# a separate DATABASE_URL authenticated as MIGRATOR_DATABASE_USER. Startup and
# migration both fail closed when the declared role boundary is not true.
APP_DATABASE_USER=healthdocs_app
APP_DATABASE_ROLE=healthdocs_app_dml
MIGRATOR_DATABASE_USER=healthdocs_migrator
MIGRATOR_DATABASE_ROLE=healthdocs_migrator_ddl
VERIFY_DATABASE_ROLE_BOUNDARY=true

# Generate a unique random value of at least 32 characters for production.
SESSION_SECRET=
# Comma-separated HTTPS origins allowed to call the API (custom domain and
# any separate trusted web origin). Same-origin requests work automatically.
APP_ORIGINS=
# Canonical deployed URL used for email links and QR links.
PUBLIC_APP_URL=
# Production defaults to Lax. Use none only for a trusted cross-site preview.
SESSION_COOKIE_SAME_SITE=lax
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=

# Guarded first-production-admin job. Do not store the password in a committed
# file; inject it from Secret Manager only for the one-shot job, then destroy
# that secret version. The command refuses to run once any admin exists.
BOOTSTRAP_CONFIRM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_NAME_AR=
BOOTSTRAP_ADMIN_EMPLOYEE_NUMBER=
BOOTSTRAP_ADMIN_ROLE=
# Use an existing facility ID, or leave it empty and set the three explicit
# facility-creation values below for a completely fresh database.
BOOTSTRAP_FACILITY_ID=
BOOTSTRAP_CREATE_FACILITY=
BOOTSTRAP_FACILITY_NAME=
BOOTSTRAP_FACILITY_NAME_AR=

# Object storage. Choose gcs, oci, or filesystem explicitly. Keep this blank so
# a copied production environment fails closed instead of enabling a provider
# accidentally. The repository-verified malware-screened path is the encrypted
# single-host filesystem acceptance profile. GCS/OCI direct uploads remain
# disabled for real documents until bounded ingress, malware quarantine, and an
# auditable orphan-retention job are deployed and accepted.
OBJECT_STORAGE_PROVIDER=
GOOGLE_CLOUD_PROJECT=
# Format: /bucket-name/private (the bucket must remain private)
PRIVATE_OBJECT_DIR=
# Optional data-sovereignty endpoint, e.g. https://storage.me-central2.rep.googleapis.com
STORAGE_API_ENDPOINT=

# Single-host filesystem profile (required only when provider=filesystem).
# Use an absolute directory outside this repository on an encrypted volume.
LOCAL_OBJECT_STORAGE_DIR=

# Required by the Windows filesystem production profile. Upload bytes are
# staged under a random name in this private directory, scanned by the exact
# Microsoft-signed Defender executable, then removed before object persistence.
# Keep the quarantine outside Git on an encrypted volume with restricted ACLs.
MALWARE_SCAN_PROVIDER=
WINDOWS_DEFENDER_MPCMDRUN_PATH=
MALWARE_QUARANTINE_DIR=
MALWARE_SCAN_TIMEOUT_MS=60000

# Oracle Object Storage S3 compatibility (required only when provider=oci).
# The endpoint must be the exact tenancy namespace endpoint in me-riyadh-1,
# for example https://NAMESPACE.compat.objectstorage.me-riyadh-1.oraclecloud.com
OCI_OBJECT_STORAGE_ENDPOINT=
OCI_OBJECT_STORAGE_REGION=me-riyadh-1
OCI_OBJECT_STORAGE_ACCESS_KEY_ID=
OCI_OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Gemini OCR (optional; only required when OCR is used)
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=

# Email alerts (disabled safely until a provider is provisioned)
EMAIL_ALERTS_DISABLED=1
EMAIL_FROM=
RESEND_API_KEY=

# Optional durable workflow automation (disabled by default). Event production
# and delivery are separate switches so the API does not need the HMAC secret.
AUTOMATION_OUTBOX_ENABLED=false
AUTOMATION_WEBHOOK_ENABLED=false
# Explicit acknowledgement that this receiver can process multiple approved
# tenants; required whenever webhook delivery is enabled.
AUTOMATION_WEBHOOK_MODE=SINGLE_CONTROLLER
# Comma-separated positive facility IDs. Required when outbox production or
# webhook delivery is enabled; no wildcard is accepted.
AUTOMATION_FACILITY_ALLOWLIST=
AUTOMATION_WEBHOOK_URL=
# Exact comma-separated hostnames only (no wildcard/scheme/path). The configured
# URL hostname must match one entry and production delivery rejects private IPs.
AUTOMATION_WEBHOOK_HOST_ALLOWLIST=
# Generate at least 32 random bytes, canonical Base64; store only in Secret Manager.
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_WEBHOOK_TIMEOUT_MS=10000
AUTOMATION_OUTBOX_MAX_ATTEMPTS=8
AUTOMATION_OUTBOX_BATCH_SIZE=25
AUTOMATION_OUTBOX_POLL_MS=30000
AUTOMATION_OUTBOX_LOCK_TIMEOUT_MS=300000
AUTOMATION_OUTBOX_RETENTION_DAYS=30
AUTOMATION_OUTBOX_PENDING_MAX_AGE_DAYS=7
# once = Cloud Run Job / scheduler; continuous = dedicated worker service.
AUTOMATION_WORKER_MODE=once

# Web build configuration. Production is served at the domain root.
BASE_PATH=/
