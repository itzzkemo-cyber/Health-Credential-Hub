# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=

# Generate a unique random value of at least 32 characters for production.
SESSION_SECRET=

# Demo and account provisioning (production-safe defaults)
DEMO_LOGIN_ENABLED=false
ALLOW_DEMO_SEED=false
SELF_REGISTRATION_ENABLED=false
GOOGLE_AUTO_PROVISION_ENABLED=false

# Object storage
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Gemini OCR (optional; only required when OCR is used)
AI_INTEGRATIONS_GEMINI_BASE_URL=
AI_INTEGRATIONS_GEMINI_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REPLIT_DOMAINS=

# Email alerts (disabled safely until a provider is provisioned)
EMAIL_ALERTS_DISABLED=1
EMAIL_FROM=

# Web/mobile build configuration
BASE_PATH=/health-docs/
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:4173/health-docs
EXPO_PUBLIC_DOMAIN=
REPLIT_INTERNAL_APP_DOMAIN=
REPLIT_DEV_DOMAIN=
REPLIT_EXPO_DEV_DOMAIN=
REPL_ID=
EXPO_PUBLIC_REPL_ID=
